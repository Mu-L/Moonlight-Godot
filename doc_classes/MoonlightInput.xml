<?xml version="1.0" encoding="UTF-8" ?>
<class name="MoonlightInput" inherits="Resource" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../doc/class.xsd">
	<brief_description>
		包含 MoonlightStreamCore 所有与输入相关的常量的资源类。
	</brief_description>
	<description>
		该类为各种输入事件提供了枚举，包括鼠标按钮、键盘动作、触摸事件、控制器按钮以及 Sunshine 服务器使用的 Win32 虚拟键码。
	</description>
	<tutorials>
	</tutorials>
	<methods>
		<method name="godot_to_virtual_key">
			<brief_description>将 Godot 键码转换为 Win32 虚拟键码。</brief_description>
			<description>接受 Godot 键码（例如 `KEY_A` 或 `KEY_ESCAPE`）并返回对应的 Win32 虚拟键码值，用于在 Windows 上发送键盘事件。若无法映射，则返回 0。</description>
			<argument name="godot_key" type="int" />
			<return type="int">映射后的虚拟键码 (VirtualKey 枚举值)，或 0 表示未知。</return>
		</method>
	</methods>
