{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "dependencies": [
    {
      "name": "curl",
      "features": [
        "brotli",
        "http2",
        "openssl"
      ]
    },
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": [
        "avcodec",
        "avformat",
        "swresample",
        "swscale",
        "avfilter",
        "gpl",
        "x264",
        "aom",
        "dav1d",
        "vulkan",
        "opus"
      ]
    },
    "godot-cpp",
    "moonlight-common-c"
  ]
}

