{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "dependencies": [
    {
      "name": "curl",
      "features": [
        "brotli",
        "http2",
        "openssl"
      ]
    },
    {
      "name": "ffmpeg",
      "features": [
        "gpl",
        "x264",
        "x265",
        "aom",
        "dav1d",
        "nvcodec",
        "amf",
        "qsv",
        "vulkan",
        "opus"
      ]
    },
    "godot-cpp",
    "moonlight-common-c"
  ]
}