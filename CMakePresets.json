{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "$env{VCPKG_DEFAULT_TRIPLET}",
        "CMAKE_COMPILE_WARNING_AS_ERROR": "FALSE"
      }
    },
    { "name": "linux", "inherits": "base" },
    { "name": "windows", "inherits": "base" },
    {
      "name": "macos",
      "inherits": "base",
      "cacheVariables": { "CMAKE_OSX_ARCHITECTURES": "$env{CMAKE_OSX_ARCHITECTURES}" }
    },
    {
      "name": "android",
      "inherits": "base",
      "cacheVariables": {
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "$env{ANDROID_ABI}",
        "ANDROID_PLATFORM": "android-21"
      }
    },
    {
      "name": "ios",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "12.0"
      }
    }
  ],
  "buildPresets": [
    { "name": "linux", "configurePreset": "linux" },
    { "name": "windows", "configurePreset": "windows" },
    { "name": "macos", "configurePreset": "macos" },
    { "name": "android", "configurePreset": "android" },
    { "name": "ios", "configurePreset": "ios" }
  ]
}