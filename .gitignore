# Godot auto generated files
*.gen.*
.godot/

# Build Artifacts (Libraries and Binaries)
bin/**/*.dll
bin/**/*.so
bin/**/*.dylib
bin/**/*.a
bin/**/*.lib
bin/**/*.exp
bin/**/*.pdb

demo/addons/moonlight-godot/bin/**/*.dll
demo/addons/moonlight-godot/bin/**/*.so
demo/addons/moonlight-godot/bin/**/*.dylib
demo/addons/moonlight-godot/bin/**/*.a
demo/addons/moonlight-godot/bin/**/*.lib
demo/addons/moonlight-godot/bin/**/*.exp
demo/addons/moonlight-godot/bin/**/*.pdb

# Allow metadata and config files in these directories
!bin/**/.gitkeep
!demo/addons/moonlight-godot/bin/*.gdextension
!demo/addons/moonlight-godot/bin/*.uid
!demo/addons/moonlight-godot/bin/**/.gitkeep

# Ignore custom.py
custom.py

# Ignore generated compile_commands.json
compile_commands.json

# Ignore files generated for documentation
/src/gen

# Binaries
*.o
*.os
*.so
*.obj
*.bc
*.pyc
*.dblite
*.pdb
*.lib
*.config
*.creator
*.creator.user
*.files
*.includes
*.idb
*.exp

# Other stuff
*.log

# VSCode
.vscode/*
!.vscode/extensions.json
.DS_Store

# Jetbrains
.idea/

# Cmake
cmake-build*
CMakeUserPresets.json
build/*
out/*

src/lib/ffmpeg/*

vcpkg_installed/*
src/doc_classes.cpp
